{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "controllerPathGlobs": [
    "src/routes/controllers/**/*Controller.ts"
  ],
  "spec": {
    "outputDirectory": "src/routes/openapi",
    "specVersion": 3,
    "specFileBaseName": "openapi",
    "basePath": "/api"
  },
  "routes": {
    "routesDir": "src/routes/generated",
    "middleware": "express"
  }
}

